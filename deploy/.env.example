# Copiá este archivo como ".env" EN EL SERVIDOR y completalo. Nunca lo subas a GitHub.

# Tu dirección, sin "https://" (por ejemplo: sampachoconecta.duckdns.org)
DOMAIN=

# Contraseña de las cuentas de prueba (solo si vas a cargar datos de prueba). Mínimo 12 caracteres.
SEED_PASSWORD=

# Contraseña de la cuenta real de la municipalidad (para el comando create-admin). Mínimo 12 caracteres.
ADMIN_PASSWORD=

# Avisos al teléfono (opcional). Se generan con:
#   docker compose run --rm tools node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@tu-dominio.ar
