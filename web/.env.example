# Copiar a .env.local. Nunca publicar credenciales.
# Neon: cadena POOLED del panel Connect, con sslmode=require.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST-pooler.neon.tech/neondb?sslmode=require
# Local: postgres:18 en docker-compose.dev.yml (puerto 55438).
# DATABASE_URL=postgresql://sampacho:CONTRASENA_LOCAL@127.0.0.1:55438/sampacho_dev
POSTGRES_PASSWORD=

# Un Blob store PRIVADO dedicado a este entorno. Obligatorio en Vercel.
BLOB_READ_WRITE_TOKEN=

# Opcionales. Generar con web-push; no pegar claves reales en este archivo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@TU-DOMINIO

# Solo para comandos locales, no necesarios en el proyecto Vercel.
SEED_PASSWORD=
ADMIN_PASSWORD=
# SEED_DISABLE_AUTO=1
# Solo PC: fotos locales en desarrollo. Nunca usar en Vercel.
# SAMPACHO_DATA_DIR=./data
# ALLOW_LOCAL_UPLOADS=1

# SEO / Google. SOLO en el proyecto REAL. Sin ellas (sitio de ejemplo, previews, local) todo queda con noindex.
# SITE_URL=https://sampachoconecta.com.ar
# SITE_INDEXING=on
# GOOGLE_SITE_VERIFICATION=
