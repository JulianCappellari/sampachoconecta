{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx --conditions=react-server scripts/seed.mts",
    "create-admin": "tsx --conditions=react-server scripts/create-admin.mts",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.mts",
    "db:import-sqlite": "tsx --conditions=react-server scripts/import-sqlite.mts",
    "test": "node --test scripts/weather.test.mjs && node --conditions=react-server --import=tsx --test scripts/uploads.test.mts",
    "test:db": "node --conditions=react-server --import=tsx --test scripts/db.test.mts",
    "test:cli": "tsx --conditions=react-server scripts/cli.test.mts",
    "test:routes": "tsx --conditions=react-server scripts/routes.test.mts",
    "test:actions": "tsx --conditions=react-server scripts/actions.test.mts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@vercel/blob": "^2.9.0",
    "gsap": "^3.15.1",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.27",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
